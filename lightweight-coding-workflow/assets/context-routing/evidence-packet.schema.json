{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lightweight-coding-workflow:evidence-packet-schema:2.1",
  "title": "PLAN Evidence Task Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "packet_type",
    "plan_id",
    "task_id",
    "task_kind",
    "status",
    "summary",
    "findings",
    "facts_for_parent",
    "assumptions",
    "unknowns",
    "expansion_requests",
    "expansions_used",
    "external_sources",
    "research_result"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "packet_type": {
      "const": "subagent-result"
    },
    "plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_kind": {
      "enum": [
        "requirement-research",
        "repository-read",
        "dependency-check",
        "evidence-analysis"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "facts_for_parent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "assumptions": {
      "$ref": "#/$defs/stringArray"
    },
    "unknowns": {
      "$ref": "#/$defs/stringArray"
    },
    "expansion_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expansionRequest"
      }
    },
    "expansions_used": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expansionUsed"
      }
    },
    "external_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalSourceEvidence"}
    },
    "research_result": {
      "$ref": "#/$defs/researchResult"
    },
    "metrics": {
      "type": "object"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "lines"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "pages"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": {"const": "symbol"},
            "name": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "heading"],
          "properties": {
            "type": {"const": "section"},
            "heading": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "key"],
          "properties": {
            "type": {"const": "object"},
            "key": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "query"],
          "properties": {
            "type": {"const": "query"},
            "query": {"type": "string", "minLength": 1},
            "top_k": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"const": "whole"}
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "locator", "note"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "locator": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "severity",
        "confidence",
        "evidence",
        "recommendation"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "claim": {"type": "string", "minLength": 1},
        "severity": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "recommendation": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "required": ["id", "statement", "provenance", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/stringArray"},
        "confidence": {
          "enum": ["confirmed", "inferred", "unverified"]
        }
      }
    },
    "expansionRequest": {
      "type": "object",
      "required": [
        "request_id",
        "task_id",
        "missing_information",
        "requested_source",
        "reason",
        "estimated_tokens"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "missing_information": {"type": "string", "minLength": 1},
        "requested_source": {
          "type": "object",
          "required": ["uri", "selector"],
          "properties": {
            "uri": {"type": "string", "minLength": 1},
            "selector": {"$ref": "#/$defs/selector"}
          }
        },
        "reason": {"type": "string", "minLength": 1},
        "estimated_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "expansionUsed": {
      "type": "object",
      "required": [
        "request_id",
        "source_id",
        "locator",
        "estimated_tokens",
        "planner_approved"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "locator": {"type": "string", "minLength": 1},
        "estimated_tokens": {"type": "integer", "minimum": 1},
        "planner_approved": {"const": true}
      }
    },
    "targetApplicability": {
      "type": "object",
      "required": ["target_versions", "target_runtimes", "notes"],
      "properties": {
        "target_versions": {"$ref": "#/$defs/stringArray"},
        "target_runtimes": {"$ref": "#/$defs/stringArray"},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "externalSourceEvidence": {
      "type": "object",
      "required": [
        "source_id",
        "source_kind",
        "uri",
        "revision",
        "retrieved_at",
        "license",
        "reuse_status",
        "target_applicability",
        "locator",
        "confidence",
        "conflicts"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "source_kind": {
          "enum": [
            "authoritative-upstream",
            "maintained-implementation",
            "upstream-issue",
            "community-secondary"
          ]
        },
        "uri": {"type": "string", "pattern": "^https?://[^\\s]+$"},
        "repository": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "license": {"type": "string", "minLength": 1},
        "reuse_status": {
          "enum": [
            "not-reused",
            "reviewed-permitted",
            "review-required",
            "prohibited",
            "unknown"
          ]
        },
        "target_applicability": {"$ref": "#/$defs/targetApplicability"},
        "locator": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["low", "medium", "high"]},
        "conflicts": {"$ref": "#/$defs/stringArray"}
      },
      "anyOf": [
        {"required": ["repository"]},
        {"required": ["project"]}
      ],
      "additionalProperties": true
    },
    "researchResult": {
      "type": "object",
      "required": [
        "status",
        "mode",
        "limitations",
        "uncertainty",
        "conflicts",
        "conflict_resolution"
      ],
      "properties": {
        "status": {
          "enum": [
            "satisfied",
            "not-required",
            "pending",
            "unavailable",
            "disabled",
            "insufficient",
            "blocked"
          ]
        },
        "mode": {
          "enum": ["cached-indexed", "live", "direct-planner", "none"]
        },
        "limitations": {"$ref": "#/$defs/stringArray"},
        "uncertainty": {"type": "string", "minLength": 1},
        "conflicts": {"$ref": "#/$defs/stringArray"},
        "conflict_resolution": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
