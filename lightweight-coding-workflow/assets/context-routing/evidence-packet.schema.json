{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lightweight-coding-workflow:evidence-packet-schema:1.1",
  "title": "Scout Evidence Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "packet_type",
    "plan_id",
    "task_id",
    "status",
    "summary",
    "findings",
    "facts_for_parent",
    "assumptions",
    "unknowns",
    "expansion_requests",
    "expansions_used"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "packet_type": {
      "const": "subagent-result"
    },
    "plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "facts_for_parent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "assumptions": {
      "$ref": "#/$defs/stringArray"
    },
    "unknowns": {
      "$ref": "#/$defs/stringArray"
    },
    "expansion_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expansionRequest"
      }
    },
    "expansions_used": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expansionUsed"
      }
    },
    "metrics": {
      "type": "object"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "lines"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "pages"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": {"const": "symbol"},
            "name": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "heading"],
          "properties": {
            "type": {"const": "section"},
            "heading": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "key"],
          "properties": {
            "type": {"const": "object"},
            "key": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "query"],
          "properties": {
            "type": {"const": "query"},
            "query": {"type": "string", "minLength": 1},
            "top_k": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"const": "whole"}
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "locator", "note"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "locator": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "severity",
        "confidence",
        "evidence",
        "recommendation"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "claim": {"type": "string", "minLength": 1},
        "severity": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "recommendation": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "required": ["id", "statement", "provenance", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/stringArray"},
        "confidence": {
          "enum": ["confirmed", "inferred", "unverified"]
        }
      }
    },
    "expansionRequest": {
      "type": "object",
      "required": [
        "request_id",
        "task_id",
        "missing_information",
        "requested_source",
        "reason",
        "estimated_tokens"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "missing_information": {"type": "string", "minLength": 1},
        "requested_source": {
          "type": "object",
          "required": ["uri", "selector"],
          "properties": {
            "uri": {"type": "string", "minLength": 1},
            "selector": {"$ref": "#/$defs/selector"}
          }
        },
        "reason": {"type": "string", "minLength": 1},
        "estimated_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "expansionUsed": {
      "type": "object",
      "required": [
        "request_id",
        "source_id",
        "locator",
        "estimated_tokens",
        "planner_approved"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "locator": {"type": "string", "minLength": 1},
        "estimated_tokens": {"type": "integer", "minimum": 1},
        "planner_approved": {"const": true}
      }
    }
  }
}
