{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lightweight-coding-workflow:orchestration-plan-schema:2.1",
  "title": "PLAN routing and task envelope",
  "type": "object",
  "additionalProperties": true,
  "oneOf": [
    {"$ref": "#/$defs/directRouting"},
    {"$ref": "#/$defs/microTask"},
    {"$ref": "#/$defs/batchPlan"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "lines"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "pages"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": {"const": "symbol"},
            "name": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "heading"],
          "properties": {
            "type": {"const": "section"},
            "heading": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "key"],
          "properties": {
            "type": {"const": "object"},
            "key": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "query"],
          "properties": {
            "type": {"const": "query"},
            "query": {"type": "string", "minLength": 1},
            "top_k": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"const": "whole"}},
          "additionalProperties": true
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["id", "uri", "selector", "estimated_tokens", "purpose", "source_kind"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "uri": {"type": "string", "minLength": 1},
        "selector": {"$ref": "#/$defs/selector"},
        "estimated_tokens": {"$ref": "#/$defs/positiveInteger"},
        "purpose": {"type": "string", "minLength": 1},
        "source_kind": {
          "enum": [
            "local-code",
            "local-test",
            "local-documentation",
            "local-log",
            "local-other",
            "authoritative-upstream",
            "maintained-implementation",
            "upstream-issue",
            "community-secondary"
          ]
        },
        "repository": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "license": {"type": "string", "minLength": 1},
        "reuse_status": {
          "enum": [
            "not-reused",
            "reviewed-permitted",
            "review-required",
            "prohibited",
            "unknown"
          ]
        },
        "target_applicability": {"$ref": "#/$defs/targetApplicability"},
        "locator": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["low", "medium", "high"]},
        "conflicts": {"$ref": "#/$defs/stringArray"},
        "summary": {"type": "string"},
        "content_hash": {"type": "string"}
      },
      "additionalProperties": true
    },
    "economics": {
      "type": "object",
      "required": [
        "planner_context_savings",
        "delegated_input_tokens",
        "estimated_result_tokens",
        "coordination_overhead_tokens",
        "weighted_cost_savings",
        "weighted_cost_rationale",
        "independently_describable",
        "evidence_already_present",
        "continuous_planner_judgment"
      ],
      "properties": {
        "planner_context_savings": {"$ref": "#/$defs/nonNegativeInteger"},
        "delegated_input_tokens": {"$ref": "#/$defs/nonNegativeInteger"},
        "estimated_result_tokens": {"$ref": "#/$defs/nonNegativeInteger"},
        "coordination_overhead_tokens": {"$ref": "#/$defs/nonNegativeInteger"},
        "weighted_cost_savings": {"type": "number"},
        "weighted_cost_rationale": {"type": "string", "minLength": 1},
        "independently_describable": {"type": "boolean"},
        "evidence_already_present": {"type": "boolean"},
        "continuous_planner_judgment": {"type": "boolean"},
        "total_token_savings_claimed": {"const": false}
      },
      "additionalProperties": true
    },
    "planTaskPolicy": {
      "type": "object",
      "required": [
        "model",
        "reasoning_effort",
        "max_concurrent_tasks",
        "max_estimated_input_tokens_per_round",
        "pass_parent_transcript",
        "sandbox_mode",
        "allow_writes",
        "allow_external_mutations",
        "user_visible_dispatch_notice",
        "per_task_approval_required",
        "over_policy",
        "managed_web_research"
      ],
      "properties": {
        "model": {"const": "gpt-5.6-luna"},
        "reasoning_effort": {"const": "max"},
        "max_concurrent_tasks": {"const": 2},
        "max_estimated_input_tokens_per_round": {"const": 12000},
        "pass_parent_transcript": {"const": false},
        "sandbox_mode": {"const": "read-only"},
        "allow_writes": {"const": false},
        "allow_external_mutations": {"const": false},
        "user_visible_dispatch_notice": {"const": true},
        "per_task_approval_required": {"const": false},
        "over_policy": {"const": "user-approval-or-direct-fallback"},
        "managed_web_research": {"$ref": "#/$defs/managedWebResearchPolicy"}
      },
      "additionalProperties": true
    },
    "planTaskAuthorization": {
      "type": "object",
      "required": ["authorized", "model", "reasoning_effort", "task_count", "token_ceiling"],
      "properties": {
        "authorized": {"const": true},
        "model": {"const": "gpt-5.6-luna"},
        "reasoning_effort": {"const": "max"},
        "task_count": {"$ref": "#/$defs/positiveInteger"},
        "token_ceiling": {"$ref": "#/$defs/positiveInteger"}
      },
      "additionalProperties": true
    },
    "configuration": {
      "type": "object",
      "required": ["id", "source", "revision", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/positiveInteger"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    },
    "routing": {
      "type": "object",
      "required": [
        "decision",
        "estimated_files",
        "estimated_tokens",
        "multiple_information_boundaries",
        "basis",
        "economics"
      ],
      "properties": {
        "decision": {"enum": ["direct", "micro", "batch"]},
        "estimated_files": {"$ref": "#/$defs/nonNegativeInteger"},
        "estimated_tokens": {"$ref": "#/$defs/nonNegativeInteger"},
        "multiple_information_boundaries": {"type": "boolean"},
        "basis": {"type": "string", "minLength": 1},
        "economics": {"$ref": "#/$defs/economics"}
      },
      "additionalProperties": true
    },
    "batchRouting": {
      "allOf": [
        {"$ref": "#/$defs/routing"},
        {"properties": {"decision": {"const": "batch"}}}
      ]
    },
    "fact": {
      "type": "object",
      "required": ["id", "statement", "provenance", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/stringArray"},
        "confidence": {"enum": ["confirmed", "inferred", "unverified"]},
        "always_share": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "sharedContext": {
      "type": "object",
      "required": ["facts", "constraints", "source_ids"],
      "properties": {
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "constraints": {"$ref": "#/$defs/stringArray"},
        "source_ids": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": true
    },
    "expansionPolicy": {
      "type": "object",
      "required": ["mode", "max_additional_tokens"],
      "properties": {
        "mode": {"enum": ["deny", "request"]},
        "max_additional_tokens": {"$ref": "#/$defs/nonNegativeInteger"}
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "task_kind",
        "agent_role",
        "objective",
        "dependencies",
        "source_ids",
        "questions",
        "deliverable",
        "evidence_required",
        "intentional_overlap",
        "allowed_expansion",
        "stop_conditions"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "agent_id": {"type": "string", "minLength": 1},
        "task_kind": {"enum": ["requirement-research", "repository-read", "dependency-check", "evidence-analysis", "implementation"]},
        "agent_role": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "dependencies": {"$ref": "#/$defs/stringArray"},
        "source_ids": {"$ref": "#/$defs/stringArray"},
        "questions": {"$ref": "#/$defs/stringArray"},
        "deliverable": {"type": "string", "minLength": 1},
        "evidence_required": {"type": "boolean"},
        "intentional_overlap": {"type": "boolean"},
        "capabilities": {"$ref": "#/$defs/stringArray"},
        "allowed_expansion": {"$ref": "#/$defs/expansionPolicy"},
        "web_research": {"$ref": "#/$defs/webResearchRequest"},
        "stop_conditions": {"$ref": "#/$defs/stringArray"},
        "inherit_shared_sources": {"type": "boolean", "default": true}
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "required": [
        "max_subagents",
        "max_input_tokens_per_task",
        "max_total_dispatched_tokens",
        "max_accidental_overlap_ratio",
        "max_shared_source_tokens_per_task"
      ],
      "properties": {
        "max_subagents": {"$ref": "#/$defs/positiveInteger"},
        "max_input_tokens_per_task": {"$ref": "#/$defs/positiveInteger"},
        "max_total_dispatched_tokens": {"$ref": "#/$defs/positiveInteger"},
        "max_accidental_overlap_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_shared_source_tokens_per_task": {"$ref": "#/$defs/nonNegativeInteger"}
      },
      "additionalProperties": true
    },
    "merge": {
      "type": "object",
      "required": ["strategy", "conflict_policy", "final_checks"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "conflict_policy": {"type": "string", "minLength": 1},
        "final_checks": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": true
    },
    "targetApplicability": {
      "type": "object",
      "required": ["target_versions", "target_runtimes", "notes"],
      "properties": {
        "target_versions": {"$ref": "#/$defs/stringArray"},
        "target_runtimes": {"$ref": "#/$defs/stringArray"},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "managedWebResearchPolicy": {
      "type": "object",
      "required": [
        "capability",
        "allowed_task_kinds",
        "allowed_modes",
        "read_only",
        "shell_network",
        "external_mutations",
        "unavailable_fallback"
      ],
      "properties": {
        "capability": {"const": "managed-web-research"},
        "allowed_task_kinds": {"const": ["dependency-check", "requirement-research"]},
        "allowed_modes": {"const": ["cached-indexed", "live"]},
        "read_only": {"const": true},
        "shell_network": {"const": false},
        "external_mutations": {"const": false},
        "unavailable_fallback": {"const": "direct-planner-or-blocked"}
      },
      "additionalProperties": true
    },
    "webResearchRequest": {
      "type": "object",
      "required": [
        "requested",
        "mode",
        "capability",
        "availability",
        "fallback",
        "reason",
        "read_only",
        "shell_network",
        "external_mutations"
      ],
      "properties": {
        "requested": {"type": "boolean"},
        "mode": {"enum": ["cached-indexed", "live", "none"]},
        "capability": {"const": "managed-web-research"},
        "availability": {
          "enum": ["available", "unavailable", "disabled", "insufficient"]
        },
        "fallback": {
          "enum": ["task-evidence", "direct-planner", "blocked", "uncertain", "not-applicable"]
        },
        "reason": {"type": "string", "minLength": 1},
        "read_only": {"const": true},
        "shell_network": {"const": false},
        "external_mutations": {"const": false}
      },
      "additionalProperties": true
    },
    "hostCapability": {
      "type": "object",
      "required": [
        "capability",
        "status",
        "mode",
        "read_only",
        "shell_network",
        "external_mutations",
        "verified",
        "verification_method",
        "verification"
      ],
      "properties": {
        "capability": {"const": "managed-web-research"},
        "status": {
          "enum": ["available", "unavailable", "disabled", "insufficient", "not-checked"]
        },
        "mode": {
          "enum": ["cached-indexed", "live", "direct-planner", "none"]
        },
        "read_only": {"const": true},
        "shell_network": {"const": false},
        "external_mutations": {"const": false},
        "verified": {"type": "boolean"},
        "verification_method": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1},
        "verified_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      },
      "additionalProperties": true
    },
    "researchEvidence": {
      "type": "object",
      "required": ["source_id", "locator", "note", "confidence"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "locator": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["low", "medium", "high"]},
        "conflicts": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": true
    },
    "externalSourceEvidence": {
      "type": "object",
      "required": [
        "source_id",
        "source_kind",
        "uri",
        "revision",
        "retrieved_at",
        "license",
        "reuse_status",
        "target_applicability",
        "locator",
        "confidence",
        "conflicts"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "source_kind": {
          "enum": [
            "authoritative-upstream",
            "maintained-implementation",
            "upstream-issue",
            "community-secondary"
          ]
        },
        "uri": {"type": "string", "pattern": "^https?://[^\\s]+$"},
        "repository": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "license": {"type": "string", "minLength": 1},
        "reuse_status": {
          "enum": [
            "not-reused",
            "reviewed-permitted",
            "review-required",
            "prohibited",
            "unknown"
          ]
        },
        "target_applicability": {"$ref": "#/$defs/targetApplicability"},
        "locator": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["low", "medium", "high"]},
        "conflicts": {"$ref": "#/$defs/stringArray"}
      },
      "anyOf": [
        {"required": ["repository"]},
        {"required": ["project"]}
      ],
      "additionalProperties": true
    },
    "externalResearch": {
      "type": "object",
      "required": [
        "decision",
        "reason",
        "status",
        "mode",
        "decision_critical",
        "architecture_relevant",
        "evidence_bar",
        "target_applicability",
        "source_ids",
        "evidence",
        "limitations",
        "uncertainty",
        "risk",
        "stop_conditions",
        "conflicts",
        "conflict_resolution",
        "fallback",
        "host_capability"
      ],
      "properties": {
        "decision": {"enum": ["required", "recommended", "not-required"]},
        "reason": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "satisfied",
            "not-required",
            "pending",
            "unavailable",
            "disabled",
            "insufficient",
            "blocked"
          ]
        },
        "mode": {"enum": ["cached-indexed", "live", "direct-planner", "none"]},
        "decision_critical": {"type": "boolean"},
        "architecture_relevant": {"type": "boolean"},
        "evidence_bar": {
          "enum": [
            "authoritative-plus-maintained",
            "authoritative-only-with-reason",
            "context-only",
            "not-applicable"
          ]
        },
        "target_applicability": {"$ref": "#/$defs/targetApplicability"},
        "source_ids": {"$ref": "#/$defs/stringArray"},
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/externalSourceEvidence"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/researchEvidence"}
        },
        "limitations": {"$ref": "#/$defs/stringArray"},
        "uncertainty": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "stop_conditions": {"$ref": "#/$defs/stringArray"},
        "conflicts": {"$ref": "#/$defs/stringArray"},
        "conflict_resolution": {"type": "string", "minLength": 1},
        "fallback": {
          "enum": ["task-evidence", "direct-planner", "blocked", "uncertain", "not-applicable"]
        },
        "live_reason": {"type": "string", "minLength": 1},
        "only_one_source_reason": {"type": "string", "minLength": 1},
        "host_capability": {"$ref": "#/$defs/hostCapability"}
      },
      "additionalProperties": true
    },
    "responseContract": {
      "type": "object",
      "required": [
        "schema_version",
        "packet_type",
        "schema_ref",
        "validation_authority",
        "task_kinds",
        "finding_severity_values",
        "finding_confidence_values",
        "evidence_fields",
        "fact_fields",
        "fact_confidence_values",
        "external_source_fields",
        "research_result_fields"
      ],
      "properties": {
        "schema_version": {"const": "2.1"},
        "packet_type": {"const": "subagent-result"},
        "schema_ref": {"const": "assets/context-routing/evidence-packet.schema.json"},
        "validation_authority": {"const": "scripts/validate_evidence_packet.py"},
        "task_kinds": {
          "const": ["dependency-check", "evidence-analysis", "repository-read", "requirement-research"]
        },
        "finding_severity_values": {
          "const": ["critical", "high", "low", "medium"]
        },
        "finding_confidence_values": {
          "const": ["high", "low", "medium"]
        },
        "evidence_fields": {
          "const": ["source_id", "locator", "note"]
        },
        "fact_fields": {
          "const": ["id", "statement", "provenance", "confidence"]
        },
        "fact_confidence_values": {
          "const": ["confirmed", "inferred", "unverified"]
        },
        "external_source_fields": {
          "const": [
            "source_id",
            "source_kind",
            "uri",
            "repository",
            "project",
            "revision",
            "retrieved_at",
            "license",
            "reuse_status",
            "target_applicability",
            "locator",
            "confidence",
            "conflicts"
          ]
        },
        "research_result_fields": {
          "const": [
            "status",
            "mode",
            "limitations",
            "uncertainty",
            "conflicts",
            "conflict_resolution"
          ]
        }
      },
      "additionalProperties": true
    },
    "executionRules": {
      "type": "object",
      "required": [
        "read_only",
        "write_authority",
        "external_mutations",
        "pass_parent_transcript",
        "may_make_decisions",
        "may_author_contract",
        "may_spawn_agents"
      ],
      "properties": {
        "read_only": {"const": true},
        "write_authority": {"const": "none"},
        "external_mutations": {"const": "forbidden"},
        "pass_parent_transcript": {"const": false},
        "may_make_decisions": {"const": false},
        "may_author_contract": {"const": false},
        "may_spawn_agents": {"const": false}
      },
      "additionalProperties": true
    },
    "batchPlan": {
      "type": "object",
      "required": [
        "envelope_type",
        "schema_version",
        "plan_id",
        "goal",
        "mode",
        "configuration",
        "routing",
        "external_research",
        "plan_task_authorization",
        "plan_task_policy",
        "budget",
        "shared_context",
        "sources",
        "tasks",
        "merge"
      ],
      "properties": {
        "envelope_type": {"const": "batch-plan"},
        "schema_version": {"const": "2.1"},
        "plan_id": {"$ref": "#/$defs/identifier"},
        "goal": {"type": "string", "minLength": 1},
        "mode": {"enum": ["lean", "balanced", "independent-review", "high-assurance"]},
        "configuration": {"$ref": "#/$defs/configuration"},
        "routing": {"$ref": "#/$defs/batchRouting"},
        "external_research": {"$ref": "#/$defs/externalResearch"},
        "plan_task_authorization": {"$ref": "#/$defs/planTaskAuthorization"},
        "plan_task_policy": {"$ref": "#/$defs/planTaskPolicy"},
        "assumptions": {"$ref": "#/$defs/stringArray"},
        "budget": {"$ref": "#/$defs/budget"},
        "shared_context": {"$ref": "#/$defs/sharedContext"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
        "merge": {"$ref": "#/$defs/merge"}
      },
      "additionalProperties": true
    },
    "microBudget": {
      "type": "object",
      "required": ["estimated_input_tokens", "max_input_tokens", "max_result_tokens"],
      "properties": {
        "estimated_input_tokens": {"$ref": "#/$defs/positiveInteger"},
        "max_input_tokens": {"$ref": "#/$defs/positiveInteger"},
        "max_result_tokens": {"$ref": "#/$defs/positiveInteger"}
      },
      "additionalProperties": true
    },
    "microTask": {
      "type": "object",
      "required": [
        "schema_version",
        "envelope_type",
        "plan_id",
        "task_id",
        "task_kind",
        "goal",
        "objective",
        "query",
        "sources",
        "deliverable",
        "stop_conditions",
        "evidence_required",
        "allowed_expansion",
        "budget",
        "economics",
        "plan_task_policy",
        "plan_task_authorization",
        "model_override",
        "external_research",
        "response_contract",
        "execution_rules"
      ],
      "properties": {
        "schema_version": {"const": "2.1"},
        "envelope_type": {"const": "micro-task"},
        "plan_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "task_kind": {"enum": ["requirement-research", "repository-read", "dependency-check", "evidence-analysis"]},
        "agent_id": {"type": "string", "minLength": 1},
        "agent_role": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "questions": {"$ref": "#/$defs/stringArray"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "deliverable": {"type": "string", "minLength": 1},
        "stop_conditions": {"$ref": "#/$defs/stringArray"},
        "evidence_required": {"const": true},
        "allowed_expansion": {"$ref": "#/$defs/expansionPolicy"},
        "budget": {"$ref": "#/$defs/microBudget"},
        "economics": {"$ref": "#/$defs/economics"},
        "plan_task_policy": {"$ref": "#/$defs/planTaskPolicy"},
        "plan_task_authorization": {"$ref": "#/$defs/planTaskAuthorization"},
        "model_override": {
          "type": "object",
          "required": ["model", "reasoning_effort", "explicit"],
          "properties": {
            "model": {"const": "gpt-5.6-luna"},
            "reasoning_effort": {"const": "max"},
            "explicit": {"const": true}
          },
          "additionalProperties": true
        },
        "external_research": {"$ref": "#/$defs/externalResearch"},
        "web_research": {"$ref": "#/$defs/webResearchRequest"},
        "configuration": {"$ref": "#/$defs/configuration"},
        "response_contract": {"$ref": "#/$defs/responseContract"},
        "execution_rules": {"$ref": "#/$defs/executionRules"}
      },
      "additionalProperties": true
    },
    "directRouting": {
      "type": "object",
      "required": [
        "schema_version",
        "envelope_type",
        "plan_id",
        "goal",
        "routing",
        "external_research"
      ],
      "properties": {
        "schema_version": {"const": "2.1"},
        "envelope_type": {"const": "routing-decision"},
        "plan_id": {"$ref": "#/$defs/identifier"},
        "goal": {"type": "string", "minLength": 1},
        "routing": {
          "allOf": [
            {"$ref": "#/$defs/routing"},
            {"properties": {"decision": {"const": "direct"}}}
          ]
        },
        "external_research": {"$ref": "#/$defs/externalResearch"}
      },
      "additionalProperties": true
    }
  }
}
